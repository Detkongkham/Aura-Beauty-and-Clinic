# apps/web-admin — copy to .env.local before `pnpm dev`
VITE_API_BASE_URL=http://localhost:4000/api/v1
# false = hit the real @abcp/backend (needs `pnpm --filter @abcp/backend dev` + `pnpm db:seed`).
# true  = run fully offline against the MSW mock handlers (src/mocks/).
VITE_ENABLE_MOCKS=false
VITE_APP_NAME=Aura Admin
