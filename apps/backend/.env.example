# ຄັດລອກເປັນ .env ກ່ອນ run (pnpm --filter @abcp/backend db:migrate)
NODE_ENV=development
PORT=4000

# PostgreSQL (ຕົງກັບ docker-compose.yml)
DATABASE_URL=postgresql://abcp:abcp_dev_pw@localhost:5432/abcp?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Storage (local disk adapter)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_URL=http://localhost:4000/uploads

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Wave 10C — ຮັບເງິນສົດ/ຈ່າຍຄືນເງິນສົດ ຕ້ອງມີກະລິ້ນຊັກເປີດຢູ່ (true/false; ແກ້ໄດ້ໃນ Settings ຂອງລະບົບ)
CASH_REQUIRE_OPEN_DRAWER=true

# ຂໍ້ຈຳກັດ 10G — ຊ່ອງທາງແຄມເປນ (ຫວ່າງ = ປິດຊ່ອງນັ້ນ; ແຄມເປນຈະຂ້າມ ແລະ ລາຍງານ skippedNoProvider)
# SMS: gateway HTTP (POST JSON {to, from, message}, Authorization: Bearer <token>)
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER_ID=AURA
# gateway forward ຂໍ້ຄວາມຕອບກັບ → POST /api/v1/consent/sms/inbound ພ້ອມ header X-Sms-Inbound-Secret
SMS_INBOUND_SECRET=
# Email: resend | sendgrid
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
# LINE Messaging API — webhook: POST /api/v1/consent/line/webhook
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_OA_ID=
# URL ສາທາລະນະຂອງ API (ລິ້ງຖອນຕົວໃນ SMS/ອີເມວ)
PUBLIC_API_URL=http://localhost:4000/api/v1

# /portal system status — ບ່ອນເກັບ backup (scripts/devstack.sh backup). ວ່າງ = ບໍ່ມີ backup.
BACKUP_DIR=../../.devstack/backups
