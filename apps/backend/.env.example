# ຄັດລອກເປັນ .env ກ່ອນ run (pnpm --filter @abcp/backend db:migrate)
NODE_ENV=development
PORT=4000

# PostgreSQL (ຕົງກັບ docker-compose.yml)
DATABASE_URL=postgresql://abcp:abcp_dev_pw@localhost:5432/abcp?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Storage (local disk adapter)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_URL=http://localhost:4000/uploads

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
