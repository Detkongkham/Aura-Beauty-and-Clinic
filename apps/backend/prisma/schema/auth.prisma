// ໝວດ: Users, Access Control, Affiliates — ໂມດູນ 01, 19, 33

enum UserRole {
  SUPER_ADMIN
  BRANCH_ADMIN
  STAFF
  CUSTOMER
  AFFILIATE_PARTNER
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
}

model User {
  id                  String    @id @default(uuid())
  branchId            String?
  role                UserRole  @default(CUSTOMER)
  roleRefId           String?
  name                String
  email               String?   @unique
  phone               String    @unique
  password            String?
  avatarUrl           String?
  dateOfBirth         DateTime?
  /// ເພດ ('MALE' | 'FEMALE' | 'OTHER') — ໃຊ້ໃນໜ້າ CRM ຂອງ Web Admin.
  gender              String?
  /// ບັນທຶກພາຍໃນຂອງພະນັກງານກ່ຽວກັບລູກຄ້າ (Web Admin ▸ Customer detail).
  notes               String?
  expoPushToken       String?
  isActive            Boolean   @default(true)
  deletedAt           DateTime?
  /// opt-in ອະນຸຍາດໃຫ້ລູກຄ້າອື່ນທັກແຊັດ DIRECT ໄດ້ (Module 38 Wave 8D) — default ປິດ, ຫຼຸດຄວາມສ່ຽງ
  /// abuse ໂດຍບໍ່ຕ້ອງລໍຖ້າ report ກ່ອນ.
  allowDirectMessages Boolean   @default(false)
  quickLoginPin       String?
  quickLoginEnabled   Boolean   @default(false)
  quickLoginUpdatedAt DateTime?
  lastLoginAt         DateTime?
  lastLoginDevice     String?
  /// ເວລາປ່ຽນລະຫັດຜ່ານຫຼ້າສຸດ (ໜ້າ /account ▸ Security) — null = ຍັງບໍ່ເຄີຍປ່ຽນ.
  passwordChangedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  branch                Branch?                    @relation(fields: [branchId], references: [id])
  roleRef               Role?                      @relation(fields: [roleRefId], references: [id])
  permissionOverrides   UserPermissionOverride[]
  staffProfile          StaffProfile?
  affiliateProfile      AffiliateProfile?
  appointments          Appointment[]              @relation("CustomerAppointments")
  bookedGroups          BookingGroup[]             @relation("GroupPayer")
  loyaltyAccount        LoyaltyAccount?
  treatmentNotes        TreatmentRecord[]
  consentForms          ConsentForm[]
  reviews               Review[]
  userPackages          UserPackage[]
  skinAnalyses          SkinHairAnalysis[]
  telegramLink          TelegramLink?
  lineLink              LineLink?
  referralCode          ReferralCode?
  usedReferrals         ReferralUsage[]            @relation("ReferredUser")
  purchasedCards        GiftCard[]                 @relation("BuyerCards")
  redeemedCards         GiftCard[]                 @relation("RedeemedCards")
  issuedCards           GiftCard[]                 @relation("IssuedCards")
  auditLogs             AuditLog[]
  stockMovements        StockMovement[]
  stockTransfers        StockTransfer[]
  expensesCreated       Expense[]                  @relation("ExpenseCreatedBy")
  expensesApproved      Expense[]                  @relation("ExpenseApprovedBy")
  recurringExpenses     RecurringExpense[]
  expensesVoided        Expense[]                  @relation("ExpenseVoidedBy")
  expenseBudgetsUpdated ExpenseBudget[]            @relation("ExpenseBudgetUpdatedBy")
  cashFundsCreated      CashFund[]                 @relation("CashFundCreatedBy")
  cashFundEntries       CashFundEntry[]            @relation("CashFundEntryCreatedBy")
  waitlists             Waitlist[]
  chatParticipants      ConversationParticipant[]
  sentMessages          ChatMessage[]              @relation("SentMessages")
  campaigns             CampaignRecipient[]
  marketingConsents     MarketingConsent[]
  notifications         NotificationLog[]
  resolvedNotifications NotificationLog[]          @relation("NotificationResolvedBy")
  pushDevices           PushDevice[]
  sessions              UserSession[]
  requestedRefunds      Refund[]                   @relation("RefundRequestedBy")
  approvedRefunds       Refund[]                   @relation("RefundApprovedBy")
  bankChangesRequested  BankAccountChangeRequest[] @relation("BankChangeRequestedBy")
  bankChangesReviewed   BankAccountChangeRequest[] @relation("BankChangeReviewedBy")
  uploadedSlips         PaymentSlip[]              @relation("SlipUploadedBy")
  reviewedSlips         PaymentSlip[]              @relation("SlipReviewedBy")
  claimedSlips          PaymentSlip[]              @relation("SlipClaimedBy")
  reversedSlips         PaymentSlip[]              @relation("SlipReversedBy")

  @@index([phone, role])
  @@index([deletedAt])
  @@map("users")
}

/// ເຊດຊັນເຂົ້າສູ່ລະບົບ 1 ແຖວຕໍ່ 1 ອຸປະກອນ — refresh token ຖື `sid` ຂອງແຖວນີ້.
/// ຖອນ (revokedAt) ແລ້ວ → /auth/refresh ປະຕິເສດ; access token ທີ່ອອກແລ້ວຍັງໃຊ້ໄດ້ຈົນໝົດ TTL (15 ນາທີ).
model UserSession {
  id          String    @id @default(uuid())
  userId      String
  /// PASSWORD | PIN | REGISTER | LEGACY (token ເກົ່າທີ່ບໍ່ມີ sid, ສ້າງແຖວໃຫ້ຕອນ refresh).
  method      String    @default("PASSWORD")
  deviceLabel String?
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

/// Dynamic, admin-editable job role — carries its own permission set, icon, and colour.
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  icon        String   @default("UsersRound")
  color       String   @default("#4f46e5")
  permissions String[] @default([])
  /// Seeded built-in roles (Super Admin / Branch Admin) — cannot be deleted.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model UserPermissionOverride {
  id         String   @id @default(uuid())
  userId     String
  permission String
  granted    Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@map("user_permission_overrides")
}

model AffiliateProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  commissionRate Float    @default(0.10)
  totalEarnings  Decimal  @default(0.0) @db.Decimal(16, 2)
  unpaidBalance  Decimal  @default(0.0) @db.Decimal(16, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts AffiliatePayout[]

  @@map("affiliate_profiles")
}

model AffiliatePayout {
  id                 String       @id @default(uuid())
  affiliateProfileId String
  amount             Decimal      @db.Decimal(16, 2)
  status             PayoutStatus @default(PENDING)
  payoutMethod       String
  accountDetails     String
  paidAt             DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  affiliateProfile AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  @@map("affiliate_payouts")
}
