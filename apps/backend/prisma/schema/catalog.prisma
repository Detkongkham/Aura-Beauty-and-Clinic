// ໝວດ: Multi-tenant, Branches, Currency, Services, BOM, Resources
// ໂມດູນ 02, 12, 14, 17, 25, 28, 36

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIAL
}

model Branch {
  id                 String    @id @default(uuid())
  name               String
  /// ລະຫັດສາຂາສັ້ນ (ເຊັ່ນ 'VTE-01') — ໃຊ້ໃນ dropdown / receipt.
  code               String?
  address            String
  phone              String
  email              String?
  /// Slug ຂອງແຂວງ (18 ເຂດປົກຄອງ) — ກົງກັບ web-admin LaoProvinceId.
  province           String?
  baseCurrency       String    @default("LAK")
  latitude           Float?
  longitude          Float?
  /// ເວລາເປີດ-ປິດ ຮ້ານປະຈຳວັນ (HH:mm).
  openTime           String    @default("09:00")
  closeTime          String    @default("20:00")
  /// ສິ່ງອຳນວຍຄວາມສະດວກທີ່ສາຂາມີ — enum-like string ('wifi','parking','drink','lounge','kids','card').
  amenities          String[]  @default([])
  /// Wave 11 — ເວລາເປີດ-ປິດແຍກຕາມມື້ [{ day: 0–6 (0=ອາທິດ), open, close, closed }]; null = ໃຊ້ openTime/closeTime ທຸກມື້.
  weeklyHours          Json?
  /// Wave 11 — ຜູ້ຈັດການສາຂາ (User BRANCH_ADMIN/STAFF ຂອງສາຂານີ້).
  managerUserId        String?
  /// Wave 11 — ຮູບໜ້າປົກ + ຄັງຮູບສາຂາ (URL ບໍ່ມີລາຍເຊັນ).
  coverImageUrl        String?
  photoUrls            String[]  @default([])
  /// Wave 11 — ເປົ້າໝາຍລາຍເດືອນ (ລາຍຮັບ LAK / ຈຳນວນນັດທີ່ສຳເລັດ); null = ບໍ່ຕັ້ງ.
  monthlyRevenueTarget Decimal?  @db.Decimal(16, 2)
  monthlyBookingTarget Int?
  /// Inventory audit C2 — ອະນຸຍາດໃຫ້ BOM ຕັດສະຕັອກຕິດລົບໄດ້ (backflush exception) ແທນທີ່ຈະ block
  /// ການປິດນັດໝາຍ. default ປິດ — ຄວນເປີດສະເພາະສາຂາທີ່ຍອມຮັບການແກ້ຍ້ອນຫຼັງດ້ວຍມື.
  allowNegativeStock Boolean   @default(false)
  isActive           Boolean   @default(true)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users              User[]
  staffBranches      StaffBranch[]
  services           Service[]
  rooms              Room[]
  equipments         Equipment[]
  appointments       Appointment[]
  bookingGroups      BookingGroup[]
  payments           Payment[]
  gratuities         Gratuity[]
  inventories        Product[]
  expenses           Expense[]
  recurringExpenses  RecurringExpense[]
  expenseBudgets     ExpenseBudget[]
  cashFunds          CashFund[]
  expenseAllocations ExpenseAllocation[]
  subscription       TenantSubscription?
  pricingRules       DynamicPricingRule[]
  purchaseOrders     PurchaseOrder[]
  stockMovements     StockMovement[]
  stockLots          StockLot[]
  transfersOut       StockTransfer[]            @relation("StockTransferFrom")
  transfersIn        StockTransfer[]            @relation("StockTransferTo")
  stockAdjRequests   StockAdjustmentRequest[]
  stockCounts        StockCount[]
  goodsReceipts      GoodsReceipt[]
  supplierReturns    SupplierReturn[]
  retailSales        RetailSale[]
  suppliers          Supplier[]
  productCategories  ProductCategory[]
  stockReservations  StockReservation[]
  waitlists          Waitlist[]
  giftCards          GiftCard[]
  packages           Package[]
  conversations      ChatThread[]
  queueTickets       QueueTicket[]
  campaigns          MarketingCampaign[]
  auditLogs          AuditLog[]
  closures           BranchClosure[]
  bankAccounts       BankAccount[]
  bankAccountChanges BankAccountChangeRequest[]
  paymentSlips       PaymentSlip[]

  manager            User?     @relation("ManagedBranches", fields: [managerUserId], references: [id], onDelete: SetNull)

  @@map("branches")
}

/// ວັນປິດຮ້ານ / ວັນພັກ ຂອງສາຂາ — ໃຊ້ໂດຍ slot engine ແລະ ໜ້າ Branch Closures ໃນ Web Admin.
model BranchClosure {
  id        String   @id @default(uuid())
  /// null = ປິດທຸກສາຂາ (ວັນພັກທົ່ວບໍລິສັດ).
  branchId  String?
  date      DateTime @db.Date
  reason    String
  createdAt DateTime @default(now())

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, date])
  @@index([date])
  @@map("branch_closures")
}

model ExchangeRate {
  id             String   @id @default(uuid())
  baseCurrency   String
  targetCurrency String
  rate           Decimal  @db.Decimal(12, 6)
  /// Wave 11 (F-10) — MANUAL = ເຈົ້າຂອງຕັ້ງເອງ, FEED = job ດຶງອັດຕາປະຈຳວັນ.
  source         String   @default("MANUAL")
  /// true = ຫ້າມ feed ຂຽນທັບ (ອັດຕາບັນຊີທີ່ເຈົ້າຂອງລັອກໄວ້).
  locked         Boolean  @default(false)
  fetchedAt      DateTime?
  updatedAt      DateTime @updatedAt

  @@unique([baseCurrency, targetCurrency])
  @@map("exchange_rates")
}

model TenantSubscription {
  id               String             @id @default(uuid())
  branchId         String             @unique
  planName         String
  status           SubscriptionStatus @default(ACTIVE)
  monthlyPrice     Decimal            @db.Decimal(16, 2)
  startDate        DateTime           @default(now())
  nextBillingDate  DateTime
  stripeCustomerId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("tenant_subscriptions")
}

model ServiceCategory {
  id       String    @id @default(uuid())
  name     String
  imageUrl String?
  services Service[]

  @@map("service_categories")
}

model Service {
  id              String    @id @default(uuid())
  categoryId      String
  branchId        String?
  name            String
  description     String?
  price           Decimal   @db.Decimal(16, 2)
  /// ລາຄາເຕັມກ່ອນຫຼຸດ — ສະແດງຂີດຄ້ຽນ + ປ້າຍ % ເມື່ອ > price.
  compareAtPrice  Decimal?  @db.Decimal(16, 2)
  durationMinutes Int
  imageUrl        String?
  /// ຈຸດເດັ່ນສັ້ນໆ ສຳລັບ chip (ເຊັ່ນ 'ຜົມສຸຂະພາບດີ').
  highlights      String[]  @default([])
  /// ຂັ້ນຕອນການບໍລິການ — JSON array ຂອງ { title, body }.
  steps           Json?
  requireDeposit  Boolean   @default(false)
  depositAmount   Decimal?  @db.Decimal(16, 2)
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category         ServiceCategory      @relation(fields: [categoryId], references: [id])
  branch           Branch?              @relation(fields: [branchId], references: [id])
  staffServices    StaffService[]
  appointments     Appointment[]
  packageItems     PackageItem[]
  userPackageItems UserPackageItem[]
  pricingRules     DynamicPricingRule[]
  consumables      ServiceConsumable[]
  waitlists        Waitlist[]
  consentForms     ConsentForm[]
  queueTickets     QueueTicket[]

  @@index([branchId, isActive])
  @@map("services")
}

model ServiceConsumable {
  id           String  @id @default(uuid())
  serviceId    String
  productId    String
  /// ຈຳນວນຕໍ່ຄັ້ງ ເປັນໜ່ວຍ `uomId` (null = ໜ່ວຍພື້ນຖານຂອງສິນຄ້າ). ຈຳນວນທີ່ຕັດ/ຈອງຈິງ = qtyPerUse × factorToBase.
  qtyPerUse    Decimal @db.Decimal(10, 3)
  /// M1 (ຄື້ນ 9C) — ໜ່ວຍທີ່ຂຽນ BOM (ເຊັ່ນ ml ໃນຂະນະທີ່ສະຕັອກເປັນຕຸກ). null = ໜ່ວຍພື້ນຖານ (factor 1).
  uomId        String?
  /// M1 — snapshot ຂອງ ProductUomConversion.factorToBase (ອັບເດດຕາມເມື່ອແກ້ອັດຕາແປງຂອງສິນຄ້າ). ແຖວເກົ່າ = 1.
  factorToBase Decimal @default(1) @db.Decimal(16, 6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom     Uom?    @relation(fields: [uomId], references: [id])

  @@unique([serviceId, productId])
  @@map("service_consumables")
}

model StaffService {
  id             String @id @default(uuid())
  staffProfileId String
  serviceId      String

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, serviceId])
  @@map("staff_services")
}

model Room {
  id          String  @id @default(uuid())
  branchId    String
  name        String
  isAvailable Boolean @default(true)

  branch       Branch        @relation(fields: [branchId], references: [id])
  appointments Appointment[]

  @@map("rooms")
}

model Equipment {
  id          String  @id @default(uuid())
  branchId    String
  name        String
  code        String  @unique
  isAvailable Boolean @default(true)

  branch       Branch        @relation(fields: [branchId], references: [id])
  appointments Appointment[]

  @@map("equipments")
}

model DynamicPricingRule {
  id              String  @id @default(uuid())
  branchId        String
  serviceId       String?
  ruleName        String
  dayOfWeek       Int
  startTime       String
  endTime         String
  discountPercent Float   @default(0.0)
  priceMultiplier Float   @default(1.0)
  isActive        Boolean @default(true)

  branch  Branch   @relation(fields: [branchId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])

  @@map("dynamic_pricing_rules")
}
